{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockMirror Account State",
  "type": "object",
  "required": ["as_of", "peak_nav", "current_nav", "drawdown_pct"],
  "properties": {
    "as_of": {"type": ["string", "null"], "format": "date"},
    "peak_nav": {"type": "number", "minimum": 0},
    "current_nav": {"type": "number", "minimum": 0},
    "drawdown_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "consecutive_stop_losses": {"type": "integer", "minimum": 0},
    "week_pnl_pct": {"type": "number"},
    "month_pnl_pct": {"type": "number"},
    "halt_new_open_until": {"type": ["string", "null"], "format": "date"},
    "halt_reason": {"type": ["string", "null"]},
    "position_scale": {"type": "number", "minimum": 0, "maximum": 1},
    "base_position_scale": {"type": "number", "minimum": 0, "maximum": 1},
    "last_reset_month": {"type": ["string", "null"]}
  }
}
